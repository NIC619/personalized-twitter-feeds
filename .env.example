# Twitter API v2 Credentials (OAuth 1.0a User Context)
# From Twitter Developer Portal > Your App > Keys and Tokens
TWITTER_API_KEY=your_consumer_key          # "Consumer Key" under OAuth 1.0 Keys
TWITTER_API_SECRET=your_consumer_secret    # "Consumer Secret" (shown when regenerating Consumer Key)
TWITTER_ACCESS_TOKEN=your_access_token     # "Access Token" (click Generate)
TWITTER_ACCESS_SECRET=your_access_secret   # "Access Token Secret" (shown with Access Token)
TWITTER_BEARER_TOKEN=your_bearer_token     # "Bearer Token" under App-Only Authentication

# Anthropic API
ANTHROPIC_API_KEY=your_claude_api_key

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_anon_key

# Configuration
FETCH_HOURS=24
MAX_TWEETS=100
FILTER_THRESHOLD=50            # Calibrated for claude-sonnet-5-5 (use 60 with claude-sonnet-4-6)
FAVORITE_THRESHOLD_OFFSET=20   # Starred authors: threshold - offset (e.g. 50-20=30)
MUTED_THRESHOLD_OFFSET=15      # Muted authors: threshold + offset (e.g. 50+15=65)
SCHEDULE_HOUR=9
SCHEDULE_TIMEZONE=Asia/Taipei
# Comma-separated weekday names to skip (e.g. "sunday" or "saturday,sunday").
# Evaluated in SCHEDULE_TIMEZONE. Empty = run every day.
SCHEDULE_SKIP_WEEKDAYS=

# Scoring
# CLAUDE_MODEL=claude-sonnet-5-5       # Compare candidates with scripts/eval_prompt.py before changing; recalibrate FILTER_THRESHOLD
# EXPLORATION_PER_RUN=2                # Random below-threshold items sent per run, marked 🎲
# REDIRECT_BASE_URL=                   # Click-tracking link base (/r/<id>); defaults to WEBHOOK_URL in prod
# FEED_MAX_ENTRIES_PER_RUN=10          # Newest entries fetched per subscribed feed per run
# PROFILE_SOURCE=compiled              # 'compiled' injects LLM-compiled profiles into scoring; 'static' = baseline
# PROFILE_COMPILE_WEEKDAY=sunday       # Weekly recompile day in --schedule mode (empty disables)

# Newsletters by email: forward issues (or auto-filter them) into a mailbox
# or Gmail label the bot reads over IMAP. Unseen messages are processed after
# each daily digest and on /inbox. Gmail: enable IMAP, use an app password,
# and set the folder to the label name.
# EMAIL_IMAP_HOST=imap.gmail.com
# EMAIL_IMAP_USER=you@example.com
# EMAIL_IMAP_PASSWORD=app_password
# EMAIL_IMAP_FOLDER=Newsletters          # Default INBOX
# EMAIL_MAX_PER_RUN=10
# EMAIL_DELETE_PROCESSED=false           # true: delete processed emails instead of marking them read

# OpenAI Embeddings (Phase 2 RAG)
# RAG_ENABLED=true                                   # Set to false to disable RAG context in Claude prompts
# OPENAI_API_KEY=your_openai_api_key
# EMBEDDING_MODEL=text-embedding-3-small        # Default; also supports text-embedding-3-large
# RAG_SIMILARITY_LIMIT=3                         # Nearest voted neighbours attached to each item
